# Server-only settings. Set them in Vercel (Settings → Environment Variables) and, for the
# guest script, in a local .env (git-ignored). Never prefix with PUBLIC_: nothing here may
# reach the browser.

# Supabase → Project Settings → API. The secret key (sb_secret_…) bypasses Row Level Security.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Shared key for venue staff on /checkin/ (at least 24 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CHECKIN_KEY=

# Live site address, used for personal links (npm run guests) and link previews.
SITE_URL=https://<project>.vercel.app

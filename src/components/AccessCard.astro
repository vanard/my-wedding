---
// Entry Access Card: shown after "Buka Undangan" and from the QR side button.
// The QR is drawn only for personal links (?k=<guest code>), by src/scripts/access-card.ts.
// It links to the staff check-in page, which verifies the code on the server.
import Icon from './Icon.astro';
import { invitation } from '../content/invitation';
import { longDate, timeRange } from '../lib/format';
const { couple, events, timeZone } = invitation;
const first = events[0];
const last = events[events.length - 1];
const date = first ? longDate(first.startsAt, timeZone) : '';
const time = first && last ? timeRange(first.startsAt, last.endsAt, timeZone) : '';
const venue = first?.venue ?? '';
---
<dialog class="access" aria-labelledby="access-title" data-access-card
  data-couple={`${couple.first} & ${couple.second}`} data-venue={venue} data-date={date} data-time={time}>
  <div class="card">
    <button type="button" class="close" data-access-close><Icon name="close" /><span class="sr-only">Tutup kartu akses</span></button>
    <p class="eyebrow">Entry Access Card</p>
    <h2 id="access-title" class="names">{couple.first} &amp; {couple.second}</h2>
    <p class="venue">{venue}</p>
    <p class="when">{date}<br />{time}</p>
    <span class="line" aria-hidden="true"></span>
    <div class="qr" data-access-qr>
      <p class="no-code" data-access-missing>Kode QR tersedia pada tautan undangan pribadi Anda.</p>
    </div>
    <p class="eyebrow to">Kepada Yth.</p>
    <p class="honorific">Bapak/Ibu/Saudara/i</p>
    <p class="guest" data-guest-name>Tamu Undangan</p>
    <p class="note" data-access-note hidden>Tunjukkan kode QR ini kepada penerima tamu di lokasi acara.</p>
    <!-- Pinned to the bottom of the card, so saving is always in reach on short screens. -->
    <div class="actions">
      <button type="button" class="button block" data-access-download hidden><Icon name="download" size={16} />Simpan Kartu</button>
      <p class="status" role="status" data-access-status></p>
    </div>
  </div>
</dialog>
<style>
  .access { width: min(calc(100vw - 2rem), 22rem); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; border: 0; background: transparent; color: var(--ink); overflow: auto; }
  .access::backdrop { background: rgb(12 12 11 / 0.8); }
  .access[open] { animation: rise .35s ease both; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px) scale(.98); } }
  .card { position: relative; padding: 2rem 1.5rem 1.4rem; border-radius: 14px; text-align: center; background: rgb(31 31 30 / 0.95); border: 1px solid rgb(244 240 232 / 0.18); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); box-shadow: 0 24px 60px rgb(0 0 0 / 0.45); }
  .close { position: absolute; top: .4rem; right: .4rem; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: var(--ink); }
  .close:hover { background: rgb(244 240 232 / 0.1); }
  .eyebrow { margin-bottom: .5rem; }
  .names { font-size: 2.6rem; text-transform: none; margin: 0 0 .6rem; }
  .venue { font-weight: 700; margin-bottom: .1rem; }
  .when { font-size: .82rem; color: var(--muted); margin-bottom: 1rem; }
  .line { display: block; width: 2.5rem; height: 1px; margin: 0 auto 1.2rem; background: var(--line); }
  .qr { display: grid; place-items: center; width: min(100%, 13.5rem, 30vh); width: min(100%, 13.5rem, 30dvh); min-width: 9.5rem; aspect-ratio: 1; margin: 0 auto 1.2rem; padding: .7rem; border-radius: 10px; background: #fbf9f5; color: #23231f; }
  .qr :global(svg) { display: block; width: 100%; height: 100%; }
  .no-code { margin: 0; padding: .5rem; font-size: .78rem; line-height: 1.5; color: #57534c; }
  .to { margin-bottom: .2rem; }
  .honorific { font-size: .8rem; margin-bottom: .1rem; }
  .guest { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.2; margin-bottom: .8rem; overflow-wrap: anywhere; }
  .note { font-size: .78rem; font-style: italic; color: var(--muted); margin-bottom: 1rem; }
  .button :global(svg) { flex: none; }
  .actions { position: sticky; bottom: 0; margin: 0 -1.5rem -1.4rem; padding: .6rem 1.5rem .9rem; border-radius: 0 0 14px 14px; background: linear-gradient(rgb(31 31 30 / 0), rgb(31 31 30) .6rem); }
  .status { margin-top: .4rem; min-height: 0; }
  .status:empty { margin: 0; }
  /* Short screens (small phones, browser toolbars): tighten so the whole card fits. */
  @media (max-height: 760px) {
    .card { padding-top: 1.4rem; }
    .eyebrow { margin-bottom: .3rem; }
    .names { font-size: 2.1rem; margin-bottom: .3rem; }
    .when { margin-bottom: .6rem; }
    .line { margin-bottom: .7rem; }
    .qr { margin-bottom: .7rem; padding: .5rem; }
    .guest { font-size: 1.4rem; margin-bottom: .4rem; }
    .note { margin-bottom: .2rem; }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .card { background: var(--glass-strong); } }
</style>

---
// Wedding Gift. The main accounts are always listed. Further accounts (when `showMore`) open in
// a pop-up from a button (src/scripts/gift-more.ts moves the list into the dialog). Without JavaScript or
// <dialog> support, that list simply stays visible below the main accounts.
import Icon from './Icon.astro';
import GiftAccount from './GiftAccount.astro';
import { invitation } from '../content/invitation';
const { gifts } = invitation;
// Hidden accounts are not rendered at all, so they are not in the page source either.
const more = gifts?.showMore ? gifts.more : [];
---
{gifts && (
  <section id="gift" class="section gift" aria-labelledby="gift-heading">
    <div class="center" data-reveal>
      <h2 id="gift-heading">Wedding Gift</h2>
      <p class="muted small">{gifts.text}</p>
    </div>
    <ul data-reveal>
      {gifts.accounts.map((account) => <GiftAccount account={account} />)}
    </ul>
    {more.length > 0 && (
      <div class="more" data-gift-more>
        <h3 class="more-title">Rekening &amp; dompet digital lainnya</h3>
        <ul data-gift-more-list>
          {more.map((account) => <GiftAccount account={account} />)}
        </ul>
      </div>
      <button type="button" class="button block more-open" aria-haspopup="dialog" data-gift-more-open hidden>
        Lihat rekening lainnya
      </button>
    )}
    <p class="status center" role="status" data-copy-status></p>
  </section>
)}
{more.length > 0 && (
  <dialog class="sheet" aria-labelledby="gift-more-heading" data-gift-dialog>
    <div class="card">
      <button type="button" class="close" data-gift-close><Icon name="close" /><span class="sr-only">Tutup</span></button>
      <p class="eyebrow">Wedding Gift</p>
      <h2 id="gift-more-heading" class="sheet-title">Rekening &amp; Dompet Digital</h2>
      <div data-gift-dialog-body></div>
      <p class="status center" role="status" data-copy-status></p>
    </div>
  </dialog>
)}
<style>
  ul { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.2rem; }
  .more { margin-top: 2rem; }
  .more-title { margin: 0; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; text-align: center; }
  .more ul { margin-top: 1.2rem; }
  .more-open { margin-top: 1.75rem; }

  .sheet { width: min(calc(100vw - 2rem), 24rem); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; border: 0; background: transparent; color: var(--ink); overflow: auto; }
  .sheet::backdrop { background: rgb(12 12 11 / 0.8); }
  .sheet[open] { animation: rise .35s ease both; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) { .sheet[open] { animation: none; } }
  .card { position: relative; padding: 2rem 1.4rem 1.2rem; border-radius: 14px; background: rgb(31 31 30 / 0.97); border: 1px solid rgb(244 240 232 / 0.18); box-shadow: 0 24px 60px rgb(0 0 0 / 0.45); }
  .card .eyebrow { margin-bottom: .4rem; text-align: center; }
  .sheet-title { margin: 0; font-size: 2rem; text-align: center; text-transform: none; }
  .card ul { margin-top: 1.5rem; }
  .close { position: absolute; top: .4rem; right: .4rem; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: var(--ink); }
  .close:hover { background: rgb(244 240 232 / 0.1); }
</style>

---
import Icon from './Icon.astro';
import MusicPlayer from './MusicPlayer.astro';
import { invitation } from '../content/invitation';
const { couple, gifts } = invitation;
const links = [
  ['#home', 'Beranda'],
  ['#couple', 'Mempelai'],
  ['#event', 'Acara'],
  ['#gallery', 'Galeri'],
  ['#rsvp', 'RSVP'],
  ['#wishes', 'Ucapan'],
  ...(gifts ? [['#gift', 'Hadiah']] : []),
];
---
<button type="button" class="menu-toggle glass" aria-expanded="false" aria-controls="site-menu" data-menu-toggle hidden>
  <Icon name="menu" /><span class="sr-only">Buka menu</span>
</button>
<div id="site-menu" class="menu" data-menu hidden>
  <nav class="panel glass" aria-label="Navigasi undangan">
    <button type="button" class="close glass" data-menu-close>Tutup</button>
    <ul>{links.map(([href, label]) => <li><a href={href} data-menu-link>{label}</a></li>)}</ul>
  </nav>
  <p class="chip glass"><Icon name="mail" size={22} /><span><small>Undangan untuk</small><span class="name" data-guest-name>Tamu Undangan</span></span></p>
</div>
<div class="toast" data-toast hidden>
  <div role="status">
    <p class="toast-title">Hai, <span data-guest-name>Tamu Undangan</span></p>
    <p>Anda diundang ke hari pernikahan kami.</p>
    <p class="toast-sign">{couple.first} &amp; {couple.second}</p>
  </div>
  <button type="button" class="toast-close" data-toast-close><Icon name="close" size={16} /><span class="sr-only">Tutup sapaan</span></button>
</div>
<div class="side" data-side-controls hidden>
  <button type="button" class="round glass" data-fullscreen hidden aria-pressed="false">
    <span class="expand"><Icon name="expand" /></span><span class="shrink"><Icon name="shrink" /></span>
    <span class="sr-only" data-fullscreen-label>Layar penuh</span>
  </button>
  <MusicPlayer />
</div>
<style is:global>
  .round { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border-radius: 50%; color: var(--ink); }
</style>
<style>
  .menu-toggle { position: fixed; z-index: 30; top: calc(.9rem + env(safe-area-inset-top)); right: calc(.9rem + env(safe-area-inset-right)); display: grid; place-items: center; width: 64px; height: 44px; border-radius: 99px; color: var(--ink); }
  .menu { position: fixed; z-index: 35; top: calc(.75rem + env(safe-area-inset-top)); right: calc(.75rem + env(safe-area-inset-right)); width: min(calc(var(--col) - 1.5rem), 22rem); }
  .panel { position: relative; padding: 1.2rem 1.5rem 1.4rem; border-radius: 14px; animation: drop .35s ease both; }
  .close { position: absolute; top: .55rem; right: .55rem; min-height: 40px; padding: 0 1rem; border-radius: 99px; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--ink); }
  ul { list-style: none; padding: 0; margin: 0; }
  li a { display: flex; align-items: center; min-height: 44px; font-size: 1.05rem; text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .chip { display: inline-flex; align-items: center; gap: .75rem; margin: .6rem 0 0; padding: .6rem 1rem; border-radius: 10px; animation: drop .35s .08s ease both; }
  .chip small { display: block; font-size: .65rem; color: var(--muted); }
  .chip .name { display: block; font-size: .85rem; overflow-wrap: anywhere; }
  @keyframes drop { from { opacity: 0; transform: translateY(-10px); } }
  .toast { position: fixed; z-index: 32; top: 38%; right: calc(var(--col) / 2); transform: translateX(50%); width: min(calc(var(--col) - 4rem), 17rem); padding: 1.1rem 2.6rem 1rem 1.2rem; border-radius: 8px; background: #fbf9f5; color: #23231f; box-shadow: 0 20px 50px rgb(0 0 0 / 0.35); animation: pop .4s ease both; }
  .toast p { margin: 0; font-size: .75rem; color: #57534c; }
  .toast .toast-title { font-size: .9rem; font-weight: 700; color: #23231f; margin-bottom: .3rem; overflow-wrap: anywhere; }
  .toast .toast-sign { margin-top: .8rem; color: #23231f; }
  .toast-close { position: absolute; top: .2rem; right: .2rem; display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: none; color: #23231f; }
  @keyframes pop { from { opacity: 0; transform: translateX(50%) scale(.94); } }
  .side { position: fixed; z-index: 30; right: calc(.9rem + env(safe-area-inset-right)); bottom: calc(1rem + env(safe-area-inset-bottom)); display: grid; justify-items: end; gap: .6rem; }
  .shrink { display: none; }
  [aria-pressed='true'] .shrink { display: contents; }
  [aria-pressed='true'] .expand { display: none; }
</style>

---
import { Picture } from 'astro:assets';
import type { Photo } from '../content/invitation';

interface Props {
  photo: Photo;
  widths?: number[];
  sizes?: string;
  class?: string;
  /** Only the cover image should load eagerly with high priority. */
  priority?: boolean;
}
const { photo, widths = [480, 768, 1080], sizes = '(min-width: 960px) 480px, 100vw', class: className = 'fill', priority = false } = Astro.props;
---
<Picture
  src={photo.src}
  alt={photo.alt}
  widths={widths.filter((width) => width <= photo.src.width)}
  sizes={sizes}
  formats={['avif', 'webp']}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  style={photo.position ? `object-position: ${photo.position}` : undefined}
/>

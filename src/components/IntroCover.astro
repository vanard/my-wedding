---
import Photo from './Photo.astro';
import { invitation } from '../content/invitation';
import { coverDate } from '../lib/format';
const { couple, photos, isPreview } = invitation;
const date = coverDate(invitation.startsAt, invitation.timeZone);
---
<header class="cover screen" id="cover">
  <div class="bg"><Photo photo={photos.cover} priority /></div>
  {isPreview && <p class="preview">Pratinjau · nama, tanggal &amp; foto masih sementara</p>}
  <div class="top">
    <p class="date eyebrow"><span>{date.dayMonth}</span><span>{date.year}</span></p>
    <p class="eyebrow">The wedding of</p>
    <h1>{couple.first} &amp;<br />{couple.second}</h1>
  </div>
  <div class="bottom">
    <p class="eyebrow">Kepada</p>
    <p class="guest" data-guest-name>Tamu Undangan</p>
    <p class="small">Dengan segala hormat, kami mengundang Anda untuk menghadiri acara pernikahan kami.</p>
    <a class="button" href="#invitation" data-open-invitation>Buka Undangan</a>
  </div>
</header>
<style>
  .cover { --overlay: linear-gradient(180deg, rgb(18 18 17 / 0.55), rgb(18 18 17 / 0.15) 40%, rgb(18 18 17 / 0.25) 60%, rgb(18 18 17 / 0.8)); position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: space-between; padding: calc(2.5rem + env(safe-area-inset-top)) var(--gutter) calc(2.5rem + env(safe-area-inset-bottom)); text-align: center; overflow: hidden; }
  /* While leaving, the cover floats over the revealed invitation and slides away. */
  .cover.is-leaving { position: fixed; z-index: 40; top: 0; right: 0; width: var(--col); height: 100vh; height: 100dvh; transition: transform .9s cubic-bezier(.7, 0, .2, 1), opacity .9s ease; transform: translateY(-100%); opacity: .4; }
  .preview { position: absolute; top: calc(.5rem + env(safe-area-inset-top)); left: 0; right: 0; margin: 0; font-size: .62rem; letter-spacing: .08em; color: var(--muted); }
  .date { display: flex; justify-content: space-between; max-width: 15rem; margin: 0 auto 2.5rem; }
  h1 { font-size: 3.6rem; font-size: clamp(3rem, 17cqi, 4.4rem); margin: .8rem 0 0; }
  .bottom { max-width: 20rem; margin-inline: auto; }
  .bottom .eyebrow { margin-bottom: .2rem; }
  .guest { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.2; margin-bottom: .6rem; overflow-wrap: anywhere; }
  .small { margin-bottom: 1.5rem; }
</style>

---
import { invitation } from '../content/invitation';
import { coverDate } from '../lib/format';
const { couple, isPreview } = invitation;
const date = coverDate(invitation.startsAt, invitation.timeZone);

// No photo of its own: the shared backdrop (background.jpg, then the teaser video) shows
// through on phones and in the desktop column. cover.jpg belongs to the desktop left side.
---
<header class="cover screen" id="cover">
  <div class="top">
    <p class="eyebrow">The wedding of</p>
    <h1>{couple.first} &amp; {couple.second}</h1>
  </div>
  <div class="bottom">
    <p class="eyebrow">Kepada Yth.</p>
    <p class="small honorific">Bapak/Ibu/Saudara/i</p>
    <p class="guest" data-guest-name>Tamu Undangan</p>
    <p class="small">Dengan segala hormat, kami mengundang Anda untuk menghadiri acara pernikahan kami.</p>
    <a class="button" href="#invitation" data-open-invitation>Buka Undangan</a>
  </div>
</header>
<style>
  .cover { position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: space-between; padding: calc(2.5rem + env(safe-area-inset-top)) var(--gutter) calc(2.5rem + env(safe-area-inset-bottom)); text-align: center; overflow: hidden; }
  /* The names sit lower on taller phones (about 100 px down on a 844 px screen), and keep
     the 2.5rem minimum on short and landscape screens where space is tight. */
  @supports (padding-top: 1svh) {
    .cover { padding-top: calc(clamp(2.5rem, 12svh, 6.5rem) + env(safe-area-inset-top)); }
  }
  /* While leaving, the cover floats over the revealed invitation and slides away. */
  .cover.is-leaving { position: fixed; z-index: 40; top: 0; right: 0; width: var(--col); height: 100vh; height: 100dvh; transition: transform .9s cubic-bezier(.7, 0, .2, 1), opacity .9s ease; transform: translateY(-100%); opacity: .4; }
  .preview { position: absolute; top: calc(.5rem + env(safe-area-inset-top)); left: 0; right: 0; margin: 0; font-size: .62rem; letter-spacing: .08em; color: var(--muted); }
  .date { display: flex; justify-content: space-between; max-width: 15rem; margin: 0 auto 2.5rem; }
  /* Names on one line, sized to the column (cqi) so they fit from 320 px phones up. */
  h1 { font-size: 3rem; font-size: clamp(2.3rem, 12.5cqi, 4.6rem); white-space: nowrap; margin: .8rem 0 0; }
  .bottom { max-width: 20rem; margin-inline: auto; }
  .bottom .eyebrow { margin-bottom: .2rem; }
  .honorific { margin-bottom: .1rem; }
  .guest { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.2; margin-bottom: .6rem; overflow-wrap: anywhere; }
  .small { margin-bottom: 1.5rem; }
  /* Desktop: draw the top and bottom groups toward the middle of the column. */
  @media (min-width: 960px) { .cover { padding-block: clamp(3.5rem, 13vh, 9rem); } }
</style>

---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { invitation } from '../content/invitation';

// Instagram handles may be written with or without "@" in the content file.
const handle = (value: string | null) => {
  const name = value?.trim().replace(/^@/, '') ?? '';
  return /^[A-Za-z0-9._]{1,30}$/.test(name) ? name : null;
};
// "Bapak A & Ibu B" shows as two lines, breaking before "&".
const parentLines = (text: string) => text.split(/\s+&\s+/);
---
<section id="couple" aria-labelledby="couple-heading">
  <h2 id="couple-heading" class="sr-only">Mempelai</h2>
  {invitation.people.map((person) => (
    <article class="person screen">
      <div class="bg"><Photo photo={person.photo} /></div>
      <div class="text" data-reveal>
        <p class="eyebrow">{person.label}</p>
        <h3>{person.fullName}</h3>
        <span class="line" aria-hidden="true"></span>
        <p class="eyebrow parent">{person.parentLine}</p>
        <p class="parents">{parentLines(person.parents).map((line, i) => i === 0 ? line : <><br />&amp; {line}</>)}</p>
        {handle(person.instagram) && (
          <a class="pill" href={`https://www.instagram.com/${handle(person.instagram)}/`} target="_blank" rel="noopener noreferrer">
            <Icon name="instagram" size={18} />@{handle(person.instagram)}<span class="sr-only"> (Instagram, tab baru)</span>
          </a>
        )}
      </div>
    </article>
  ))}
</section>
<style>
  .person { --overlay: linear-gradient(180deg, transparent 45%, rgb(18 18 17 / 0.85)); position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; padding: 2rem var(--gutter) calc(3rem + env(safe-area-inset-bottom)); }
  /* Kept modest so the two-line names stay below the faces in the portraits. */
  h3 { font-family: var(--font-display); font-weight: 500; font-size: 2.1rem; font-size: clamp(1.8rem, 10cqi, 2.5rem); line-height: 1.05; margin: .4rem 0 .9rem; }
  .line { display: block; width: 2.5rem; height: 1px; background: var(--ink); margin-bottom: .9rem; }
  .parent { letter-spacing: .12em; margin-bottom: .2rem; }
  .parents { margin-bottom: 1rem; color: var(--muted); }
  .pill { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: 0 1.2rem; border: 1px solid rgb(244 240 232 / 0.75); border-radius: 99px; background: rgb(20 20 19 / 0.35); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: var(--ink); font-size: .8rem; font-weight: 600; letter-spacing: .02em; text-decoration: none; transition: background-color .2s, color .2s; }
  .pill:hover { background: var(--ink); color: var(--bg); }
</style>

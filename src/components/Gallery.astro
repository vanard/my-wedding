---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { invitation } from '../content/invitation';
const { gallery, closingQuote, couple } = invitation;
// Full-size views are generated only when a guest opens them (or follows the link without JS).
const full = await Promise.all(gallery.photos.map((photo) => getImage({ src: photo.src, width: Math.min(1400, photo.src.width), format: 'webp' })));
// Justified rows, worked out here so they do not depend on the screen: a row takes photos
// (in album order) while their width/height ratios add up to at most ROW. Two portraits
// (2:3, 0.67 each) or a portrait and a square share a row; a landscape photo (1.5) has a row
// of its own. In a row, each photo's width is in proportion to its ratio, so all have the
// same height and together fill the width. A short last row is padded to a normal row.
const ROW = 1.8;
const ratio = (photo: { src: ImageMetadata }) => photo.src.width / photo.src.height;
const rows: number[][] = [];
let sum = Infinity;
gallery.photos.forEach((photo, index) => {
  const r = ratio(photo);
  if (sum + r > ROW) { rows.push([]); sum = 0; }
  rows[rows.length - 1]!.push(index);
  sum += r;
});
const lastSum = rows.at(-1)?.reduce((total, index) => total + ratio(gallery.photos[index]!), 0) ?? 0;
const spare = Math.max(0, 4 / 3 - lastSum);
---
<section id="gallery" class="section gallery" aria-labelledby="gallery-heading">
  <div class="center" data-reveal>
    <h2 id="gallery-heading">Our Moment</h2>
    <p class="muted small">“{gallery.quote}”</p>
  </div>
  {gallery.video && (
    <div class="clip" data-reveal>
      {/* Our own poster until the guest presses play: no YouTube request before that.
          Without JS the link opens the video on YouTube. */}
      <a class="facade" href={`https://www.youtube.com/watch?v=${gallery.video.youtubeId}`} data-video-clip data-youtube-id={gallery.video.youtubeId} data-title={gallery.video.title}>
        <Photo photo={gallery.video.poster} widths={[480, 768, 1080]} sizes="(min-width: 960px) 480px, 100vw" />
        <span class="play" aria-hidden="true"><Icon name="play" size={26} /></span>
        <span class="sr-only">Putar {gallery.video.title}</span>
      </a>
    </div>
  )}
  <ul class="grid" data-gallery>
    {rows.map((row, rowIndex) => [
      rowIndex > 0 && <li class="break" aria-hidden="true"></li>,
      ...row.map((index) => [index, gallery.photos[index]!] as const).map(([index, photo]) => (
      <li style={`--ar: ${ratio(photo).toFixed(4)}`}>
        <a href={full[index]?.src} data-gallery-item data-alt={photo.alt}>
          <Photo photo={photo} widths={[320, 480, 640, 960]} sizes={photo.src.width > photo.src.height ? '(min-width: 960px) 560px, 100vw' : '(min-width: 960px) 280px, 50vw'} class="tile" />
          <span class="sr-only">Perbesar foto {index + 1}</span>
        </a>
      </li>
      )),
      rowIndex === rows.length - 1 && spare > 0.05 && <li class="spare" aria-hidden="true" style={`--ar: ${spare.toFixed(4)}`}></li>,
    ])}
  </ul>
  <dialog class="lightbox" aria-label="Galeri foto" data-lightbox>
    <img alt="" data-lightbox-image />
    <p class="counter" data-lightbox-counter aria-live="polite"></p>
    <button type="button" class="lb-btn close" data-lightbox-close><Icon name="close" /><span class="sr-only">Tutup galeri</span></button>
    <button type="button" class="lb-btn prev" data-lightbox-prev><Icon name="left" /><span class="sr-only">Foto sebelumnya</span></button>
    <button type="button" class="lb-btn next" data-lightbox-next><Icon name="right" /><span class="sr-only">Foto berikutnya</span></button>
  </dialog>
</section>
{closingQuote && (
  <section class="section quote" aria-label="Kutipan">
    <figure data-reveal>
      {closingQuote.photo && <Photo photo={closingQuote.photo} widths={[480, 768, 1080]} class="mono" />}
      <figcaption>
        <blockquote><p>“{closingQuote.text}”</p></blockquote>
        <p class="sign">{couple.first} &amp; {couple.second}</p>
      </figcaption>
    </figure>
  </section>
)}
<style>
  .gallery { padding-inline: .75rem; }
  .clip { position: relative; aspect-ratio: 16 / 9; margin-top: 2rem; border-radius: 10px; overflow: hidden; background: #000; }
  .clip :global(iframe), .facade { display: block; width: 100%; height: 100%; border: 0; }
  .facade { position: relative; color: var(--ink); }
  .facade::after { content: ''; position: absolute; inset: 0; background: rgb(18 18 17 / 0.25); transition: background-color .2s; }
  .facade:hover::after { background: rgb(18 18 17 / 0.1); }
  .play { position: absolute; z-index: 1; inset: 0; margin: auto; display: grid; place-items: center; width: 64px; height: 64px; padding-left: 4px; border-radius: 50%; background: rgb(18 18 17 / 0.55); border: 1px solid rgb(244 240 232 / 0.6); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  /* Justified rows (see ROW above; no JS): a tile's width is its share (--ar) of the row. */
  .grid { display: flex; flex-wrap: wrap; column-gap: .5rem; list-style: none; padding: 0; margin: 2rem 0 0; }
  li { flex: var(--ar) 1 0; min-width: 0; margin-bottom: .5rem; }
  li.break { flex-basis: 100%; height: 0; margin: 0; }
  li a { display: block; border-radius: 8px; overflow: hidden; }
  li :global(.tile) { width: 100%; height: auto; }
  .lightbox { width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(12 12 11 / 0.96); color: var(--ink); }
  /* Photos are not zoomable in the viewer: no pinch or double-tap zoom (swipes still work,
     see gallery.ts). Zooming the page itself outside the viewer is left to the browser. */
  .lightbox { touch-action: none; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgb(12 12 11 / 0.9); }
  .lightbox img { max-width: calc(100vw - 2rem); max-height: calc(100dvh - 8rem); object-fit: contain; border-radius: 6px; }
  .counter { position: absolute; top: calc(1.2rem + env(safe-area-inset-top)); left: 1.2rem; margin: 0; font-size: .8rem; letter-spacing: .1em; }
  .lb-btn { position: absolute; display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line); border-radius: 50%; background: rgb(244 240 232 / 0.08); }
  .close { top: calc(.75rem + env(safe-area-inset-top)); right: .75rem; }
  .prev, .next { bottom: calc(1.5rem + env(safe-area-inset-bottom)); }
  .prev { left: calc(50% - 60px); }
  .next { right: calc(50% - 60px); }
  .quote { padding-inline: 0; padding-top: 3rem; }
  figure { margin: 0; }
  figure :global(.mono) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  figcaption { padding: 2rem var(--gutter) 0; }
  blockquote { margin: 0 0 .8rem; font-size: .82rem; font-weight: 600; text-align: justify; }
  .sign { text-align: right; font-size: .78rem; margin: 0; }
</style>

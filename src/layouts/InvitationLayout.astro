---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { invitation } from '../content/invitation';
interface Props { title: string; description: string; skipLink?: boolean }
const { title, description, skipLink = true } = Astro.props;

// Link preview (WhatsApp, Instagram, …), already 1200×630. Crawlers need an absolute URL,
// so it is only emitted when the site URL is known (see astro.config.mjs).
const preview = await getImage({ src: invitation.linkPreview.src, width: 1200, height: 630, format: 'jpg', quality: 85 });
const previewUrl = Astro.site ? new URL(preview.src, Astro.site).href : null;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#1f1f1e" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {previewUrl && <meta property="og:image" content={previewUrl} />}
    {previewUrl && <meta property="og:image:width" content="1200" />}
    {previewUrl && <meta property="og:image:height" content="630" />}
    {previewUrl && <meta property="og:image:alt" content={invitation.linkPreview.alt} />}
    <meta name="twitter:card" content={previewUrl ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
  </head>
  <body>
    {skipLink && <a class="skip-link" href="#invitation">Lewati pembuka</a>}
    <slot />
  </body>
</html>
<style is:global>
  .skip-link { position: fixed; left: 1rem; top: -8rem; z-index: 60; padding: .75rem 1rem; background: var(--ink); color: var(--bg); border-radius: 6px; }
  .skip-link:focus { top: 1rem; }
</style>
